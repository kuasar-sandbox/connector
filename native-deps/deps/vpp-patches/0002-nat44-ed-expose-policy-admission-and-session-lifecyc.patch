+              u32 tcp_offset = (u8 *) tcp - (u8 *) ip;
+              u32 outer_length = clib_net_to_host_u16 (ip->length);
+              if (outer_length < tcp_offset + 8 || !it_fits (vm, b, tcp, 8))
+                return NAT_ED_TRNSL_ERR_PACKET_TRUNCATED;
+              u32 quoted = outer_length - tcp_offset;
+              u32 checksum_end = STRUCT_OFFSET_OF (tcp_header_t, checksum) +
+                                 sizeof (tcp->checksum);
+              if (quoted == checksum_end - 1)
+                return NAT_ED_TRNSL_ERR_PACKET_TRUNCATED;
