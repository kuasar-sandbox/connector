+/* Bounded pre-translation guard. Error helper receives the untouched quote. */
+static_always_inline int
+nat44_ed_policy_guard (vlib_buffer_t *b, ip4_header_t *ip, u64 cookie,
+                       u64 expected_path, u32 inside_fib, u32 route_fib,
+                       ip4_address_t translated_dst, ip4_address_t forward_dst, u8 out2in)
+{
+  if (!nat44_ed_policy_hooks.path_mtu)
+    return 0;
+  int mtu = nat44_ed_policy_hooks.path_mtu (
+      cookie, expected_path, inside_fib, route_fib, translated_dst, forward_dst, out2in);
+  if (mtu < 0)
+    return -1;
+  if (mtu && clib_net_to_host_u16 (ip->length) > mtu &&
+      (clib_net_to_host_u16 (ip->flags_and_fragment_offset) & 0x4000))
+    {
+      vnet_buffer (b)->sw_if_index[VLIB_TX] = ~0;
+      b->flags &= ~VNET_BUFFER_F_IS_NATED;
