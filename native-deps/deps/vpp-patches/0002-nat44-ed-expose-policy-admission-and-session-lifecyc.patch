 snat_main_t snat_main;
 
+/* File reload publishes connection inactivity settings under the worker barrier. */
+__clib_export void
+nat44_ed_policy_timeouts (u32 udp, u32 established, u32 transitory, u32 icmp)
+{
+  snat_main.timeouts.udp = udp;
+  snat_main.timeouts.tcp.established = established;
+  snat_main.timeouts.tcp.transitory = transitory;
+  snat_main.timeouts.icmp = icmp;
+}
+
+nat44_ed_policy_hooks_t nat44_ed_policy_hooks;
+
+__clib_export int
+nat44_ed_policy_register (const nat44_ed_policy_hooks_t *hooks)
+{
+  if (nat44_ed_policy_hooks.prepare)
+    return -1;
+  nat44_ed_policy_hooks = *hooks;
+  return 0;
+}
+
+__clib_export u32
+nat44_ed_policy_walk (nat44_ed_policy_visit_t visit, void *opaque)
+{
+  snat_main_t *sm = &snat_main;
+  snat_main_per_thread_data_t *tsm;
+  snat_session_t *s;
+  u32 *remove = 0, i, *pi, deleted = 0;
+  vec_foreach (tsm, sm->per_thread_data)
+    {
+      pool_foreach_index (i, tsm->sessions)
+        {
+          s = pool_elt_at_index (tsm->sessions, i);
+          if (s->policy_cookie == NAT44_ED_POLICY_NONE || !s->policy_committed)
+            continue;
+          nat44_ed_policy_flow_t flow = {
+            .cookie = s->policy_cookie,
+            .path_signature = s->policy_path_signature,
+            .thread_index = tsm - sm->per_thread_data, .native_index = i,
+            .inside_fib = s->in2out.fib_index,
+            .outside_fib = s->out2in.fib_index,
+            .route_fib = s->i2o.rewrite.fib_index,
+            .local = s->i2o.match.saddr,
+            .original_remote = s->i2o.match.daddr,
+            .backend = s->i2o.rewrite.daddr,
+            .snat = s->out2in.addr,
+            .local_port = s->in2out.port,
+            .original_remote_port = s->i2o.match.dport,
+            .backend_port = s->i2o.rewrite.dport,
+            .snat_port = s->out2in.port, .proto = s->proto,
+          };
+          if (visit (&flow, opaque))
+            vec_add1 (remove, i);
+        }
+      vec_foreach (pi, remove)
+        {
+          s = pool_elt_at_index (tsm->sessions, *pi);
+          nat44_ed_free_session_data (sm, s, tsm - sm->per_thread_data, 0);
+          nat_ed_session_delete (sm, s, tsm - sm->per_thread_data, 1);
+          deleted++;
+        }
+      vec_reset_length (remove);
+    }
+  vec_free (remove);
+  return deleted;
+}
+
+
+__clib_export int
+nat44_ed_interface_bind (u32 sw_if_index, u8 enable)
+{
+  return enable ? nat44_ed_add_interface (sw_if_index, 1) :
+                  nat44_ed_del_interface (sw_if_index, 1);
+}
+
+/* Private file-configured Egress resource ownership. The policy plugin
+ * publishes and retires these resources while workers are stopped. */
+__clib_export int
+nat44_ed_policy_outside (u32 sw, u8 enable)
+{
+  return enable ? nat44_ed_add_interface (sw, 0) : nat44_ed_del_interface (sw, 0);
+}
+
+__clib_export int
+nat44_ed_policy_address (ip4_address_t addr, u8 enable)
+{
+  return enable ? nat44_ed_add_address (&addr, ~0, 0) : nat44_ed_del_address (addr, 0);
+}
+
+/* Caller holds the worker barrier; reuse native LRU/timeouts and deletion. */
+__clib_export u32
+nat44_ed_policy_expire (u32 per_worker_budget)
+{
+  snat_main_t *sm = &snat_main;
+  if (!sm->enabled) return 0;
+  u32 i, deleted = 0;
+  f64 now = vlib_time_now (vlib_get_main ());
+  vec_foreach_index (i, sm->per_thread_data)
+    {
+      if (vec_len (sm->per_thread_data[i].lru_pool) == 0) continue;
+      u32 budget = per_worker_budget;
+      while (budget-- && nat_lru_free_one (sm, i, now)) deleted++;
+    }
+  return deleted;
+}
+
+__clib_export u32
+nat44_ed_fib_live_sessions (u32 fib)
+{
+  snat_main_per_thread_data_t *tsm;
+  snat_session_t *s;
+  u32 count = 0;
+  vec_foreach (tsm, snat_main.per_thread_data)
+    pool_foreach (s, tsm->sessions)
+      if (s->in2out.fib_index == fib)
+        count++;
+  return count;
+}
