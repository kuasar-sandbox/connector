diff --git a/src/vpp/CMakeLists.txt b/src/vpp/CMakeLists.txt
index 5a08056..9fa9c94 100644
--- a/src/vpp/CMakeLists.txt
+++ b/src/vpp/CMakeLists.txt
@@ -87,12 +87,34 @@ if(VPP_API_TEST_BUILTIN)
   add_definitions(-DVPP_API_TEST_BUILTIN=1)
 endif()
 
+set(VPP_LINK_LIBRARIES svm vlibapi vlib vppinfra vlibmemory vnet)
+set(VPP_EXECUTABLE_OPTIONS ENABLE_EXPORTS)
+if(VPP_STATIC_EGRESS)
+  # Node, CLI, init and CPU dispatch registrations may have no ordinary symbol
+  # reference. Keep every selected object's registrations in the executable.
+  set(VPP_LINK_LIBRARIES
+      -Wl,--whole-archive
+      af_packet_plugin nat_plugin ping_plugin
+      egress_policy_plugin egress_geneve_plugin egress_packet_plugin
+      nat vnet vlibmemory vlibapi vlib svm vppinfra
+      -Wl,--no-whole-archive)
+  set(VPP_EXECUTABLE_OPTIONS "")
+endif()
+
 add_vpp_executable(vpp
-  ENABLE_EXPORTS
+  ${VPP_EXECUTABLE_OPTIONS}
   SOURCES ${VPP_SOURCES}
-  LINK_LIBRARIES svm vlibapi vlib vppinfra vlibmemory vnet Threads::Threads ${CMAKE_DL_LIBS} ${EPOLL_LIB}
+  LINK_LIBRARIES ${VPP_LINK_LIBRARIES} Threads::Threads ${CMAKE_DL_LIBS} ${EPOLL_LIB}
   DEPENDS vpp_version_h api_headers
 )
+if(VPP_STATIC_EGRESS)
+  set_target_properties(vpp PROPERTIES OUTPUT_NAME connector-vpp)
+  target_link_options(vpp PRIVATE -static
+      "-Wl,-Map,${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/connector-vpp.map")
+  if(VPP_USE_LTO)
+    set_property(TARGET vpp PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
+  endif()
+endif()
 
