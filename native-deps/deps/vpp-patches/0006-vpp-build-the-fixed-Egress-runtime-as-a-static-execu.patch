diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 74521dd..af45b72 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -45,6 +45,20 @@ endif()
 
 project(vpp C)
 
+option(VPP_STATIC_EGRESS "Build the fixed Connector Egress runtime as one static executable" OFF)
+if(VPP_STATIC_EGRESS)
+  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
+    message(FATAL_ERROR "Connector Egress requires Linux")
+  endif()
+  add_compile_definitions(VPP_STATIC_EGRESS=1)
+  set(VPP_API_TEST_BUILTIN OFF CACHE BOOL "Use builtin VPP API test." FORCE)
+  set(VPP_ALLOC_FREE_INTERCEPT OFF CACHE BOOL "intercept libc alloc/free calls" FORCE)
+  set(VPP_SET_RPATH OFF CACHE BOOL "Set rpath for resulting binaries and libraries." FORCE)
+  set(VPP_TOOLS none CACHE STRING "Tools included in build" FORCE)
+  set(VPP_PLUGINS "af_packet,nat,ping,egress_policy,egress_geneve,egress_packet"
+      CACHE STRING "Plugins included in the static Egress runtime" FORCE)
+endif()
+
 if(NOT DEFINED CMAKE_PREFIX_PATH)
   set(CMAKE_PREFIX_PATH
     /opt/vpp/external/${CMAKE_SYSTEM_PROCESSOR}
@@ -374,6 +388,8 @@ if(VPP_HOST_TOOLS_ONLY)
     DESTINATION ${VPP_RUNTIME_DIR}
     COMPONENT vpp-dev
   )
+elseif(VPP_STATIC_EGRESS)
+  set(SUBDIRS vppinfra svm vlib vlibmemory vlibapi vnet vpp plugins tools/vppapigen cmake)
 elseif(${CMAKE_SYSTEM_NAME} MATCHES "Linux|FreeBSD")
   find_package(OpenSSL)
   set(SUBDIRS
@@ -424,17 +440,19 @@ endif()
 # custom targets
 ##############################################################################
 
-add_custom_target(run
-  COMMAND ./${VPP_RUNTIME_DIR}/vpp -c startup.conf
-  COMMENT "Starting VPP..."
-  USES_TERMINAL
-)
+if(TARGET vpp)
+  add_custom_target(run
+    COMMAND $<TARGET_FILE:vpp> -c startup.conf
+    COMMENT "Starting VPP..."
+    USES_TERMINAL
+  )
 
-add_custom_target(debug
-  COMMAND gdb --args ./${VPP_RUNTIME_DIR}/vpp -c startup.conf
-  COMMENT "Starting VPP in the debugger..."
-  USES_TERMINAL
-)
+  add_custom_target(debug
+    COMMAND gdb --args $<TARGET_FILE:vpp> -c startup.conf
+    COMMENT "Starting VPP in the debugger..."
+    USES_TERMINAL
+  )
+endif()
 
 add_custom_target(config
   COMMAND ccmake ${CMAKE_BINARY_DIR}
diff --git a/src/cmake/library.cmake b/src/cmake/library.cmake
index 4ab9234..c877f82 100644
--- a/src/cmake/library.cmake
+++ b/src/cmake/library.cmake
@@ -30,7 +30,11 @@ macro(add_vpp_library lib)
     target_compile_definitions(${lo} PRIVATE ${ARG_COMPILE_DEFINITIONS})
   endif()
 
-  add_library(${lib} SHARED)
+  if(VPP_STATIC_EGRESS)
+    add_library(${lib} STATIC)
+  else()
+    add_library(${lib} SHARED)
+  endif()
   target_sources(${lib} PRIVATE $<TARGET_OBJECTS:${lo}>)
 
   if(VPP_LIB_VERSION)
@@ -58,7 +62,9 @@ macro(add_vpp_library lib)
      set_property(TARGET ${lib} PROPERTY INTERPROCEDURAL_OPTIMIZATION TRUE)
      target_compile_options (${lib} PRIVATE "-ffunction-sections")
      target_compile_options (${lib} PRIVATE "-fdata-sections")
-     target_link_libraries (${lib} "-Wl,--gc-sections")
+     if(NOT VPP_STATIC_EGRESS)
+       target_link_libraries (${lib} "-Wl,--gc-sections")
+     endif()
      if(compiler_flag_no_stringop_overflow)
        target_link_libraries (${lib} "-Wno-stringop-overflow")
      endif()
diff --git a/src/cmake/plugin.cmake b/src/cmake/plugin.cmake
index beec94f..012f217 100644
--- a/src/cmake/plugin.cmake
+++ b/src/cmake/plugin.cmake
@@ -75,13 +75,19 @@ macro(add_vpp_plugin name)
       COMPONENT ${PLUGIN_DEV_COMPONENT}
     )
   endforeach()
-  add_library(${plugin_name} SHARED ${api_includes} ${PLUGIN_SOURCES})
+  if(VPP_STATIC_EGRESS)
+    add_library(${plugin_name} STATIC ${api_includes} ${PLUGIN_SOURCES})
+  else()
+    add_library(${plugin_name} SHARED ${api_includes} ${PLUGIN_SOURCES})
+  endif()
   target_compile_options(${plugin_name} PUBLIC ${VPP_DEFAULT_MARCH_FLAGS})
   set_target_properties(${plugin_name} PROPERTIES NO_SONAME 1)
   target_compile_options(${plugin_name} PRIVATE "-fvisibility=hidden")
   target_compile_options (${plugin_name} PRIVATE "-ffunction-sections")
   target_compile_options (${plugin_name} PRIVATE "-fdata-sections")
-  target_link_libraries (${plugin_name} "-Wl,--gc-sections")
+  if(NOT VPP_STATIC_EGRESS)
+    target_link_libraries (${plugin_name} "-Wl,--gc-sections")
+  endif()
   set(deps "")
   if(NOT VPP_EXTERNAL_PROJECT)
     list(APPEND deps vpp_version_h api_headers)
@@ -118,7 +124,7 @@ macro(add_vpp_plugin name)
       )
     endforeach()
   endif()
-  if(PLUGIN_API_TEST_SOURCES)
+  if(PLUGIN_API_TEST_SOURCES AND NOT VPP_STATIC_EGRESS)
     set(test_plugin_name ${name}_test_plugin)
     add_library(${test_plugin_name} SHARED ${PLUGIN_API_TEST_SOURCES}
 		${api_includes})
@@ -139,7 +145,7 @@ macro(add_vpp_plugin name)
       COMPONENT ${PLUGIN_COMPONENT}
     )
   endif()
-  if (PLUGIN_API_FILES AND NOT PLUGIN_VAT_AUTO_TEST STREQUAL OFF)
+  if (PLUGIN_API_FILES AND NOT PLUGIN_VAT_AUTO_TEST STREQUAL OFF AND NOT VPP_STATIC_EGRESS)
     add_vpp_test_library(${name}_test_plugin ${PLUGIN_API_FILES})
   endif()
 
