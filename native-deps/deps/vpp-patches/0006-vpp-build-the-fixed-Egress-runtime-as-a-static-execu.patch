From 55c62d601f4339204811a3ff24f5d6a2bab4d630 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 26 Nov 2026 07:08:04 -0500
Subject: [PATCH 6/6] vpp: build the fixed Egress runtime as a static
 executable

---
 src/CMakeLists.txt                         | 38 ++++++++++++++++------
 src/cmake/library.cmake                    | 10 ++++--
 src/cmake/plugin.cmake                     | 14 +++++---
 src/plugins/CMakeLists.txt                 |  4 +++
 src/plugins/nat/nat44-ed/nat44_ed_policy.h |  5 +++
 src/vlib/CMakeLists.txt                    |  8 +++--
 src/vlib/unix/plugin.c                     |  8 +++++
 src/vlib/unix/plugin.h                     |  8 +++++
 src/vlibapi/jsonformat.c                   | 12 +++++++
 src/vnet/crypto/crypto.c                   |  4 +++
 src/vnet/dev/dev.c                         |  4 +++
 src/vnet/unix/gdb_funcs.c                  |  3 ++
 src/vpp/CMakeLists.txt                     | 26 +++++++++++++--
 src/vpp/api/api.c                          |  7 +++-
 src/vpp/vnet/main.c                        |  2 ++
 src/vppinfra/CMakeLists.txt                |  8 +++--
 src/vppinfra/socket.c                      |  4 +++
 src/vppinfra/unix-formats.c                | 12 +++++--
